{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": false,
    "outDir": "./dist",
    "rootDir": ".",
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "target": "ES2020",
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tsbuildinfo"
  },
  "include": ["./index.js", "./lib/**/*.js"],
  "exclude": ["./dist", "./node_modules", "./test"]
}