{
  "name": "@6edesign/data-circuits",
  "version": "0.0.10",
  "description": "A faithful (stylistically and functionally) rewrite of core/packages/data-circuits in typescript.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "pretest": "docker-compose up -d",
    "test": "REDIS_URL=redis://localhost:6380 vitest run --dir test",
    "posttest": "docker-compose down",
    "coverage": "vitest run --coverage",
    "check-types": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@6edesign/eslint-config": "workspace:^",
    "@6edesign/tsconfig": "workspace:^",
    "@types/mocha": "^10.0.6",
    "@types/sinon": "^17.0.3",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "ioredis-mock": "^8.9.0",
    "mocha": "^10.2.0",
    "sinon": "^18.0.0",
    "tsdown": "^0.13.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "ioredis": "^5.4.1",
    "millisecond": "^0.1.2",
    "redlock": "^5.0.0-beta.2",
    "zod": "^3.22.4"
  },
  "eslintConfig": {
    "extends": [
      "@6edesign/eslint-config/library.js"
    ]
  },
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./circuits": {
      "import": "./dist/circuits.mjs",
      "require": "./dist/circuits.js"
    },
    "./package.json": "./package.json"
  }
}