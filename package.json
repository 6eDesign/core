{
  "name": "@6edesign/core-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "neverBuiltDependencies": [],
    "overrides": {
      "uri-js": "npm:uri-js-replace"
    }
  },
  "description": "Shared packages and reusable workflows for 6edesign projects.",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "release": "turbo run build && changeset publish",
    "version": "changeset version && CI=false pnpm install"
  },
  "devDependencies": {
    "@6edesign/cli": "workspace:^",
    "@changesets/cli": "^2.29.7",
    "tsdown": "^0.13.5",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "packages/*"
  ]
}